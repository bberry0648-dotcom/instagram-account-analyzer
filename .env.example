# ── Server-side secrets (API server / Cloudflare Worker) ──────────────────────
# NEVER commit a real .env. In production set these with `npx wrangler secret put NAME`.

# Long-lived Instagram User access token (Instagram API with Facebook Login) with:
# instagram_basic, instagram_manage_insights, pages_read_engagement (+ ads_read if the Page role comes via Business Manager)
META_ACCESS_TOKEN=
# Your own Instagram professional account id (starts with 1784...)
META_IG_USER_ID=
META_GRAPH_VERSION=v25.0
# Max pages of 50 posts per analysis (protects rate limit)
META_MAX_PAGES=12

# Optional third-party provider (see server/providers/external.ts)
EXTERNAL_PROVIDER_URL=
EXTERNAL_PROVIDER_KEY=
EXTERNAL_PROVIDER_NAME=

ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend (public, baked into the build — put NO secrets here) ─────────────
# Base URL of the deployed API. Leave empty to run the site in import-only mode.
VITE_API_BASE_URL=http://localhost:8787
